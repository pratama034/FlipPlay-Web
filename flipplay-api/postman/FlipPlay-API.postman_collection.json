    "name": "FlipPlay REST API - Modul 4 (Laravel 12)",
    "description": "Koleksi pengujian lengkap REST API FlipPlay (Laravel 12) mencakup CRUD Media, Custom Action Koleksi User, Happy Path, dan Failure Path (422, 409, 404).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
