              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Demon Slayer: Kimetsu no Yaiba\",\n  \"type\": \"anime\",\n  \"genre\": \"Action, Supernatural\",\n  \"release_year\": 2019,\n  \"total_units\": 26,\n  \"status\": \"completed\",\n  \"description\": \"Tanjiro Kamado menjadi pembasmi iblis demi menyembuhkan adiknya, Nezuko.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/media",
              "host": ["{{base_url}}"],
              "path": ["media"]
