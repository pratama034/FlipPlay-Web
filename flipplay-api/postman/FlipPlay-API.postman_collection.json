    {
      "name": "3. Failure Paths (422, 409, 404)",
      "item": [
        {
          "name": "422 Unprocessable Entity - Invalid Fields (POST Media)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 422 Unprocessable Entity', function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "pm.test('Contains Indonesian validation errors', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('errors');",
                  "    pm.expect(json.errors).to.have.property('title');",
                  "    pm.expect(json.errors).to.have.property('type');",
                  "    pm.expect(json.errors).to.have.property('release_year');",
                  "});"
