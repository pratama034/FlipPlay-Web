        },
        {
          "name": "POST Create New Media (201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Created media matches payload', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.title).to.eql('Demon Slayer: Kimetsu no Yaiba');",
                  "});"
                ]
              }
            }
