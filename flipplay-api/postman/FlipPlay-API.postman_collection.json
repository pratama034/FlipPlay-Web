    }
  ],
  "item": [
    {
      "name": "1. Media CRUD (Happy Path)",
      "item": [
        {
          "name": "GET List All Media (Paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has paginated data and meta', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('data');",
                  "    pm.expect(json).to.have.property('meta');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/media",
              "host": ["{{base_url}}"],
              "path": ["media"]
            }
          }
        },
        {
          "name": "GET Search Media (?search=Black)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Search returns matching title', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.length).to.be.above(0);",
                  "    pm.expect(json.data[0].title.toLowerCase()).to.include('black');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/media?search=Black",
              "host": ["{{base_url}}"],
              "path": ["media"],
              "query": [
                {
                  "key": "search",
                  "value": "Black"
                }
              ]
            }
          }
        },
        {
